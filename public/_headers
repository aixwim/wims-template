# Cache strategy — aktif di Cloudflare Pages / Netlify (otomatis membaca file ini).
# GitHub Pages tidak mendukung header custom (selalu max-age=600), jadi file ini
# tidak berpengaruh di GH Pages dan hanya untuk kesiapan migrasi hosting.

# Aset hashed (immutable) — cache 1 tahun, tanpa revalidasi
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon / manifest / rss — cache harian
/favicon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/rss.xml
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

# HTML — revalidasi cepat
/*
  Cache-Control: public, max-age=600